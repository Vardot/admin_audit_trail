{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore"
  ],
  "words": [
    "admin",
    "audit",
    "trail",
    "Vardot",
    "vardot",
    "phpcs",
    "phpcbf",
    "drupal",
    "Drupal",
    "jsonapi",
    "langcode",
    "isset",
    "sprintf",
    "Symfony",
    "metatag",
    "restui",
    "oembed",
    "yoast",
    "heroslider",
    "redoc",
    "KEYTYPE",
    "LANGCODE",
    "phpcbf",
    "hookname",
    "submodule",
    "submodules",
    "entityqueue",
    "Entityqueue",
    "subqueue",
    "Subqueue",
    "subqueues",
    "predelete",
    "Drush",
    "drush",
    "varchar",
    "SAPI",
    "preg",
    "Natshah",
    "Razem"
  ]
}
