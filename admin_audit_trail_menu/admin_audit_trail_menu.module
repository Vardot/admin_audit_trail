<?php

/**
 * @file
 * Logs menu CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_menu\Hook\AdminAuditTrailMenuHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_menu_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailMenuHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_menu_insert().
 */
#[LegacyHook]
function admin_audit_trail_menu_menu_insert($menu) {
  \Drupal::service(AdminAuditTrailMenuHooks::class)->menuInsert($menu);
}

/**
 * Implements hook_menu_update().
 */
#[LegacyHook]
function admin_audit_trail_menu_menu_update($menu) {
  \Drupal::service(AdminAuditTrailMenuHooks::class)->menuUpdate($menu);
}

/**
 * Implements hook_menu_delete().
 */
#[LegacyHook]
function admin_audit_trail_menu_menu_delete($menu) {
  \Drupal::service(AdminAuditTrailMenuHooks::class)->menuDelete($menu);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for menu_link_content entities.
 */
#[LegacyHook]
function admin_audit_trail_menu_menu_link_content_insert($link) {
  \Drupal::service(AdminAuditTrailMenuHooks::class)->menuLinkContentInsert($link);
}

/**
 * Implements hook_ENTITY_TYPE_update() for menu_link_content entities.
 */
#[LegacyHook]
function admin_audit_trail_menu_menu_link_content_update($link) {
  \Drupal::service(AdminAuditTrailMenuHooks::class)->menuLinkContentUpdate($link);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for menu_link_content entities.
 */
#[LegacyHook]
function admin_audit_trail_menu_menu_link_content_delete($link) {
  \Drupal::service(AdminAuditTrailMenuHooks::class)->menuLinkContentDelete($link);
}
