<?php

/**
 * @file
 * Logs node CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_node\Hook\AdminAuditTrailNodeHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_node_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailNodeHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_node_insert().
 */
#[LegacyHook]
function admin_audit_trail_node_node_insert($node) {
  \Drupal::service(AdminAuditTrailNodeHooks::class)->nodeInsert($node);
}

/**
 * Implements hook_node_update().
 */
#[LegacyHook]
function admin_audit_trail_node_node_update($node) {
  \Drupal::service(AdminAuditTrailNodeHooks::class)->nodeUpdate($node);
}

/**
 * Implements hook_node_delete().
 */
#[LegacyHook]
function admin_audit_trail_node_node_delete($node) {
  \Drupal::service(AdminAuditTrailNodeHooks::class)->nodeDelete($node);
}

/**
 * Implements hook_ENTITY_TYPE_translation_insert() for node entities.
 */
#[LegacyHook]
function admin_audit_trail_node_node_translation_insert($node) {
  \Drupal::service(AdminAuditTrailNodeHooks::class)->nodeTranslationInsert($node);
}

/**
 * Implements hook_ENTITY_TYPE_translation_delete() for node entities.
 */
#[LegacyHook]
function admin_audit_trail_node_node_translation_delete($node) {
  \Drupal::service(AdminAuditTrailNodeHooks::class)->nodeTranslationDelete($node);
}
