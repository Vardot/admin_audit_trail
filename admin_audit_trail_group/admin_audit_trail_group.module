<?php

/**
 * @file
 * Logs user CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_group\Hook\AdminAuditTrailGroupHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_group_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailGroupHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_group_insert().
 */
#[LegacyHook]
function admin_audit_trail_group_group_insert($group) {
  \Drupal::service(AdminAuditTrailGroupHooks::class)->groupInsert($group);
}

/**
 * Implements hook_group_update().
 */
#[LegacyHook]
function admin_audit_trail_group_group_update($group) {
  \Drupal::service(AdminAuditTrailGroupHooks::class)->groupUpdate($group);
}

/**
 * Implements hook_group_delete().
 */
#[LegacyHook]
function admin_audit_trail_group_group_delete($group) {
  \Drupal::service(AdminAuditTrailGroupHooks::class)->groupDelete($group);
}
