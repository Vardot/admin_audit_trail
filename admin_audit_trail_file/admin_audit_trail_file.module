<?php

/**
 * @file
 * Logs file entity CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_file\Hook\AdminAuditTrailFileHooks;
use Drupal\file\Entity\File;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_file_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailFileHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
#[LegacyHook]
function admin_audit_trail_file_file_insert(File $file) {
  \Drupal::service(AdminAuditTrailFileHooks::class)->fileInsert($file);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
#[LegacyHook]
function admin_audit_trail_file_file_update(File $file) {
  \Drupal::service(AdminAuditTrailFileHooks::class)->fileUpdate($file);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
#[LegacyHook]
function admin_audit_trail_file_file_delete(File $file) {
  \Drupal::service(AdminAuditTrailFileHooks::class)->fileDelete($file);
}
