<?php

/**
 * @file
 * Logs comment CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_comment\Hook\AdminAuditTrailCommentHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_comment_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailCommentHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_comment_insert().
 */
#[LegacyHook]
function admin_audit_trail_comment_comment_insert($comment) {
  \Drupal::service(AdminAuditTrailCommentHooks::class)->commentInsert($comment);
}

/**
 * Implements hook_comment_update().
 */
#[LegacyHook]
function admin_audit_trail_comment_comment_update($comment) {
  \Drupal::service(AdminAuditTrailCommentHooks::class)->commentUpdate($comment);
}

/**
 * Implements hook_comment_delete().
 */
#[LegacyHook]
function admin_audit_trail_comment_comment_delete($comment) {
  \Drupal::service(AdminAuditTrailCommentHooks::class)->commentDelete($comment);
}
