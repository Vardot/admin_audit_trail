<?php

/**
 * @file
 * Logs media entity CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_media\Hook\AdminAuditTrailMediaHooks;
use Drupal\media\Entity\Media;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_media_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailMediaHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
#[LegacyHook]
function admin_audit_trail_media_media_insert(Media $media) {
  \Drupal::service(AdminAuditTrailMediaHooks::class)->mediaInsert($media);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
#[LegacyHook]
function admin_audit_trail_media_media_update(Media $media) {
  \Drupal::service(AdminAuditTrailMediaHooks::class)->mediaUpdate($media);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
#[LegacyHook]
function admin_audit_trail_media_media_delete(Media $media) {
  \Drupal::service(AdminAuditTrailMediaHooks::class)->mediaDelete($media);
}
