<?php

/**
 * @file
 * Logs user role assignment and removal events in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_user_roles\Hook\AdminAuditTrailUserRolesHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_user_roles_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailUserRolesHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_user_update().
 */
#[LegacyHook]
function admin_audit_trail_user_roles_user_update($account) {
  \Drupal::service(AdminAuditTrailUserRolesHooks::class)->userUpdate($account);
}

/**
 * Implements hook_user_role_insert().
 */
#[LegacyHook]
function admin_audit_trail_user_roles_user_role_insert($role) {
  \Drupal::service(AdminAuditTrailUserRolesHooks::class)->userRoleInsert($role);
}

/**
 * Implements hook_user_role_update().
 */
#[LegacyHook]
function admin_audit_trail_user_roles_user_role_update($role) {
  \Drupal::service(AdminAuditTrailUserRolesHooks::class)->userRoleUpdate($role);
}

/**
 * Implements hook_user_role_delete().
 */
#[LegacyHook]
function admin_audit_trail_user_roles_user_role_delete($role) {
  \Drupal::service(AdminAuditTrailUserRolesHooks::class)->userRoleDelete($role);
}
