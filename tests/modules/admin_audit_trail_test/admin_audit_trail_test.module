<?php

/**
 * @file
 * Test helper for the Admin Audit Trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_test\Hook\AdminAuditTrailTestHooks;

/**
 * Implements hook_admin_audit_trail_log_alter().
 *
 * For events whose reference name contains "LONGPATH", force a path longer than
 * the 255-character "path" column so the trim in admin_audit_trail_insert()
 * (issue #3588241) is exercised end-to-end through a real web request.
 */
#[LegacyHook]
function admin_audit_trail_test_admin_audit_trail_log_alter(array &$log) {
  \Drupal::service(AdminAuditTrailTestHooks::class)->adminAuditTrailLogAlter($log);
}
