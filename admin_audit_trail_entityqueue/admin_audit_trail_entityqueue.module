<?php

/**
 * @file
 * Logs entityqueue CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_entityqueue\Hook\AdminAuditTrailEntityqueueHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_entity_queue_insert().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_entity_queue_insert($entityqueue) {
  \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->entityQueueInsert($entityqueue);
}

/**
 * Implements hook_entity_queue_update().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_entity_queue_update($entityqueue) {
  \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->entityQueueUpdate($entityqueue);
}

/**
 * Implements hook_entity_queue_predelete().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_entity_queue_predelete($entityqueue) {
  \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->entityQueuePredelete($entityqueue);
}

/**
 * Implements hook_entity_subqueue_insert().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_entity_subqueue_insert($entity_subqueue) {
  \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->entitySubqueueInsert($entity_subqueue);
}

/**
 * Implements hook_entity_subqueue_update().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_entity_subqueue_update($entity_subqueue) {
  \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->entitySubqueueUpdate($entity_subqueue);
}

/**
 * Implements hook_entity_subqueue_predelete().
 */
#[LegacyHook]
function admin_audit_trail_entityqueue_entity_subqueue_predelete($entity_subqueue) {
  \Drupal::service(AdminAuditTrailEntityqueueHooks::class)->entitySubqueuePredelete($entity_subqueue);
}
