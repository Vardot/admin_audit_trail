<?php

/**
 * @file
 * Logs user CUD commands in the admin_audit_trail module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\admin_audit_trail_user\Hook\AdminAuditTrailUserHooks;

/**
 * Implements hook_admin_audit_trail_handlers().
 */
#[LegacyHook]
function admin_audit_trail_user_admin_audit_trail_handlers() {
  return \Drupal::service(AdminAuditTrailUserHooks::class)->adminAuditTrailHandlers();
}

/**
 * Implements hook_user_insert().
 */
#[LegacyHook]
function admin_audit_trail_user_user_insert($account) {
  \Drupal::service(AdminAuditTrailUserHooks::class)->userInsert($account);
}

/**
 * Implements hook_user_update().
 */
#[LegacyHook]
function admin_audit_trail_user_user_update($account) {
  \Drupal::service(AdminAuditTrailUserHooks::class)->userUpdate($account);
}

/**
 * Implements hook_user_delete().
 */
#[LegacyHook]
function admin_audit_trail_user_user_delete($account) {
  \Drupal::service(AdminAuditTrailUserHooks::class)->userDelete($account);
}
